{
  "name": "repodesk",
  "version": "0.5.0",
  "description": "Windows 專案控制中心：集中管理、啟動並開啟本機開發專案。",
  "repository": {
    "type": "git",
    "url": "https://github.com/Martinweiting/RepoDesk.git"
  },
  "homepage": "https://github.com/Martinweiting/RepoDesk",
  "main": "./out/main/index.js",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:renderer": "vite --config vite.renderer.config.ts --host 127.0.0.1",
    "clean:installers": "node scripts/clean-installers.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && npm run test && electron-vite build",
    "dist:win": "npm run clean:installers && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "build": {
    "appId": "app.repodesk.desktop",
    "productName": "RepoDesk",
    "artifactName": "RepoDesk-Setup-v${version}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RepoDesk"
    }
  }
}
